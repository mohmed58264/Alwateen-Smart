{
  "name": "alwateen-smart",
  "main": "server/worker.mjs",
  "compatibility_date": "2026-10-01",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": true },
  "r2_buckets": [{ "binding": "CATALOG_FILES", "bucket_name": "alwateen-catalog" }],
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }]
}
