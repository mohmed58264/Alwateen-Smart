{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alwateen-smart",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "none"
  },
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "alwateen-smart-files"
    }
  ]
}
